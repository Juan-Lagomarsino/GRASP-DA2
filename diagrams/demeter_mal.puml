@startuml
skinparam classAttributeIconSize 0
hide circle
skinparam backgroundColor transparent
skinparam shadowing false
skinparam dpi 150
skinparam classFontSize 15
skinparam classAttributeFontSize 14
skinparam ArrowColor #333333
skinparam classBorderColor #6a6a6a
skinparam class {
  BackgroundColor #FFFFCC
}
title Incorrecto — Comercio "habla con extranos" (Billetera)
actor Actor
participant ":Comercio" as C
participant ":Cliente" as Cl
participant ":Billetera" as B
Actor -> C : Cobrar(cli, monto)
C -> Cl : GetBilletera()
C -> B : GetCantidadDinero()
alt total >= monto
  C -> B : SacarDinero(monto)
  C -> B : SetCantidadDinero(...)
end
@enduml
