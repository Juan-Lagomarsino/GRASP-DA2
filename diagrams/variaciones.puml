@startuml
skinparam classAttributeIconSize 0
hide circle
skinparam backgroundColor transparent
skinparam shadowing false
skinparam dpi 150
skinparam classFontSize 15
skinparam classAttributeFontSize 14
skinparam ArrowColor #333333
skinparam classBorderColor #6a6a6a
skinparam class {
  BackgroundColor #FFFFCC
}
title Variaciones Protegidas — interfaz estable ante proveedores que cambian
class Program {
  + Main() : void
}
abstract class TemperatureAdapter {
  + {static} CreateApi(api : string) : TemperatureAdapter
  + {abstract} GetTemperature() : float
}
class GoogleTemperatureAdapter {
  + GetTemperature() : float
}
class MCRSTemperatureAdapter {
  + GetTemperature() : float
}
class GoogleAPI {
  + TEMP() : float
}
class MSFTWeatherApi {
  + GetMSWeatherTemp() : float
}
Program ..> TemperatureAdapter
GoogleTemperatureAdapter --|> TemperatureAdapter
MCRSTemperatureAdapter --|> TemperatureAdapter
GoogleTemperatureAdapter --> GoogleAPI
MCRSTemperatureAdapter --> MSFTWeatherApi
@enduml
